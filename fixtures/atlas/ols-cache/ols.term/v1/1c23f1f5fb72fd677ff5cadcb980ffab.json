{"source": "ols.term", "key": "efo|http://www.ebi.ac.uk/efo/EFO_1000275", "body": {"iri": "http://www.ebi.ac.uk/efo/EFO_1000275", "lang": "en", "description": ["A well differentiated, low grade neuroendocrine tumor (carcinoid tumor) that arises from the stomach. The vast majority of cases arise from the corpus-fundus region. The mitotic count is less than 2 per 10 HPF and/or the Ki67 index is equal to or less than 2 percent. It may be associated with autoimmune chronic atrophic gastritis, multiple endocrine neoplasia type 1, or it may be sporadic."], "synonyms": ["stomach neuroendocrine neoplasm G1", "gastric ECL cell NET G1", "gastric ECL cell NET", "gastric ECL cell, histamine-producing NET", "gastric ECL-cell carcinoid tumor", "gastric NET G1", "gastric carcinoid tumor", "gastric enterochromaffin-like cell carcinoid tumor", "gastric enterochromaffin-like cell neuroendocrine tumor", "gastric neuroendocrine tumor G1", "grade 1 neuroendocrine neoplasm of stomach", "stomach NET G1", "stomach carcinoid tumor", "stomach neuroendocrine tumor, well differentiated, low grade"], "annotation": {"Conforms To": ["http://purl.obolibrary.org/obo/mondo/patterns/neuroendocrine_neoplasm_grade1.yaml"], "database_cross_reference": ["EFO:1000275", "NCIT:C4635", "UMLS:C0349529"], "has exact match": ["http://linkedlifedata.com/resource/umls/id/C0349529", "http://purl.obolibrary.org/obo/NCIT_C4635"], "obsoleted_in_version": ["3.88.0"], "reason_for_obsolescence": ["Replaced by Mondo term MONDO_0006227, with which this term was previously merged. Use: http://purl.obolibrary.org/obo/MONDO_0006227"], "term replaced by": ["http://purl.obolibrary.org/obo/MONDO_0006227"]}, "label": "obsolete_Gastric Neuroendocrine Tumor G1", "ontology_name": "efo", "ontology_prefix": "EFO", "ontology_iri": "http://www.ebi.ac.uk/efo/efo.owl", "is_obsolete": true, "term_replaced_by": "http://purl.obolibrary.org/obo/MONDO_0006227", "is_defining_ontology": true, "has_children": false, "is_root": true, "short_form"