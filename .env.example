# Copy to .env and export before starting the server:
#
#     set -a; . ./.env; set +a
#
# Nothing in the app reads .env itself; the shell does. Every variable here
# is optional — the app runs with none of them set.

# The one paid dependency. Enables the four LLM calls (gene triage, phenotype
# summary, contrast chooser, region chooser), each behind its own spend cap in
# targetring/config.py. Without it every one of them falls back to its
# rule-based path and the figure records who actually chose.
ANTHROPIC_API_KEY=

# Where upstream payloads, finished runs and the spend ledger go.
# Defaults: ./cache, ./runs, ./runs/spend-ledger.jsonl
# TARGETRING_CACHE=
# TARGETRING_RUNS=
# TARGETRING_SPEND_LEDGER=

# Read-only demo. Serves the finished artefacts of the listed runs and refuses
# every route that fetches, analyses, renders or calls a model. A demo box
# must NOT have ANTHROPIC_API_KEY set.
# TARGETRING_DEMO=1
# TARGETRING_DEMO_RUNS=20261009T160226Z-805ee9,20260926T001101Z-9a2192
